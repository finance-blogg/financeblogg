{
  "name": "financeblogg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:content": "node scripts/check-content.mjs",
    "check:launch": "node scripts/check-content.mjs --launch",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/unit/*.test.mjs\" \"tests/db/*.test.mjs\"",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/unit/*.test.mjs\"",
    "test:db": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/db/*.test.mjs\"",
    "cms:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-mdx-to-supabase.mjs",
    "cms:backup": "node scripts/backup-cms.mjs",
    "cms:set-password": "node scripts/set-admin-password.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@uiw/react-md-editor": "^4.1.2",
    "github-slugger": "^2.0.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4"
  }
}
