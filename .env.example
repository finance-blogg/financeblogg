# Copy to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables for production.
# NEXT_PUBLIC_* values are embedded at build time: redeploy after changing them.

# --- Site -------------------------------------------------------------------
# Final production domain, used for canonical URLs, sitemap, RSS and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in
# Public contact address shown on the site (optional but recommended).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google Search Console ----------------------------------------------------
# Only the content value of the HTML-tag verification method, e.g. "abc123...".
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google AdSense -------------------------------------------------------------
# Your real publisher ID from AdSense > Account > Account information, e.g. ca-pub-1234567890123456.
# Leave empty until you have one. Nothing ad-related is loaded while it is empty.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional manual ad unit slot IDs (AdSense > Ads > By ad unit). Leave empty to disable a placement.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# --- Newsletter (optional) ------------------------------------------------------
# A signup page hosted by your newsletter provider. The section is hidden while empty.
NEXT_PUBLIC_NEWSLETTER_URL=

# --- Contact form delivery (server-side only, never exposed to the browser) -----
# Uses the Resend email API. Without all three, the form is hidden in production
# and visitors see NEXT_PUBLIC_CONTACT_EMAIL instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
