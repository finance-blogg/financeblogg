# Copy to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables for production.
# NEXT_PUBLIC_* values are embedded at build time: redeploy after changing them.

# --- Site -------------------------------------------------------------------
# Final production domain, used for canonical URLs, sitemap, RSS and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in
# Public contact address shown on the site (optional but recommended).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Google Search Console ----------------------------------------------------
# Only the content value of the HTML-tag verification method, e.g. "abc123...".
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google AdSense -------------------------------------------------------------
# Your real publisher ID from AdSense > Account > Account information, e.g. ca-pub-1234567890123456.
# Leave empty until you have one. Nothing ad-related is loaded while it is empty.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional manual ad unit slot IDs (AdSense > Ads > By ad unit). Leave empty to disable a placement.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# --- Newsletter (optional) ------------------------------------------------------
# A signup page hosted by your newsletter provider. The section is hidden while empty.
NEXT_PUBLIC_NEWSLETTER_URL=

# --- Supabase (content dashboard) -----------------------------------------------
# Supabase > Project Settings > API (or "Connect"). Without these two values the
# site runs on the MDX files only and /admin shows a setup notice.
# Public by design: Row Level Security limits this key to published content.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...). Older projects: the anon key, which
# you may put in NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Never add a NEXT_PUBLIC_ prefix and never paste it into client code.
# The "secret" key (sb_secret_...), or the legacy service_role key in
# SUPABASE_SERVICE_ROLE_KEY. Used only for login rate limiting, the
# scheduled-publishing job and the import/backup scripts.
SUPABASE_SECRET_KEY=

# SERVER-ONLY. Random string of at least 16 characters (e.g. `openssl rand -hex 32`).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/publish-scheduled.
CRON_SECRET=

# Optional. Hours a dashboard sign-in stays valid (1-168, default 12).
ADMIN_SESSION_MAX_HOURS=12

# Optional. Set to "off" after every MDX article has been imported into the
# database and checked, to stop serving the content/articles files.
CMS_MDX_ARTICLES=on

# --- Contact form delivery (server-side only, never exposed to the browser) -----
# Uses the Resend email API. Without all three, the form is hidden in production
# and visitors see NEXT_PUBLIC_CONTACT_EMAIL instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
